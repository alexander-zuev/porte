{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": ["**/.dev.vars", "**/.dev.vars.*", "**/.env", "**/.env.*"],
  "globalEnv": ["CI"],
  "globalPassThroughEnv": ["FORCE_COLOR", "WRANGLER_LOG"],
  "tasks": {
    // Cloudflare's types are generated, not committed: every task that reads
    // types runs cf-typegen first, so a fresh checkout (CI) sees what a dev does.
    "build": {
      "dependsOn": ["^build", "cf-typegen"],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.json", "vite.config.*", "wrangler.jsonc"],
      "outputs": ["dist/**", ".output/**"],
      "outputLogs": "new-only",
    },
    "dev": {
      "cache": false,
      "dependsOn": ["^build", "cf-typegen"],
      "persistent": true,
      "outputLogs": "new-only",
    },
    "cf-typegen": {
      "inputs": ["wrangler.jsonc"],
      "outputs": ["worker-configuration.d.ts"],
      "outputLogs": "new-only",
    },
    "typecheck": {
      "dependsOn": ["^build", "cf-typegen"],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.json"],
      "outputs": [],
      "outputLogs": "new-only",
    },
    "lint": {
      "dependsOn": ["^build", "cf-typegen"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "outputLogs": "new-only",
    },
    "lint:fix": {
      "cache": false,
      "outputLogs": "new-only",
    },
    "test": {
      "dependsOn": ["^build", "cf-typegen"],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.json"],
      "outputs": [],
      "outputLogs": "new-only",
    },
    "test:unit": {
      "dependsOn": ["^build", "cf-typegen"],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.json"],
      "outputs": [],
      "outputLogs": "new-only",
    },
    "test:integration": {
      "dependsOn": ["^build", "cf-typegen"],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.json"],
      "outputs": [],
      "outputLogs": "new-only",
    },
    // Real Grok, real tokens: never cached, never in CI.
    "test:live": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputLogs": "new-only",
    },
  },
}
