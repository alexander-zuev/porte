{
  "name": "lras",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm --filter @lras/web dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "preview": "pnpm --filter @lras/web preview",
    "deploy": "pnpm --filter @lras/web deploy",
    "cf-typegen": "turbo run cf-typegen"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "catalog:",
    "@oxlint/plugins": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxfmt --write --no-error-on-unmatched-pattern",
      "oxlint --fix"
    ],
    "*.{json,jsonc,yaml,yml,md,css}": [
      "oxfmt --write --no-error-on-unmatched-pattern"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.20.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
