{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "sortImports": true,
  "sortTailwindcss": {
    "stylesheet": "apps/web/src/styles.css"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.pnpm-store/**",
    "**/dist/**",
    "**/build/**",
    "**/.output/**",
    "**/.vitest/**",
    "**/.wrangler/**",
    "**/.tanstack/**",
    "**/migrations/meta/**",
    "**/*.gen.ts",
    "**/*.gen.tsx",
    "**/worker-configuration.d.ts",
    "**/pnpm-lock.yaml",
    "tools/oxlint/anti-slop/**"
  ]
}
