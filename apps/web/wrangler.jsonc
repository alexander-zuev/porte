{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "porte",
  "main": "./src/server.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "logs": { "enabled": true, "invocation_logs": true },
  },
  // Keep migration history append-only to preserve Durable Object storage across class renames.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["HostCoordinatorDO"] },
    { "tag": "v2", "renamed_classes": [{ "from": "HostCoordinatorDO", "to": "HostRelayDO" }] },
    { "tag": "v3", "renamed_classes": [{ "from": "HostRelayDO", "to": "HostRelayAgent" }] },
  ],
  "env": {
    "dev": {
      "name": "porte-dev",
      // Values must match the CRON registry, which is what the handler routes on.
      "triggers": { "crons": ["*/15 * * * *"] },
      "vars": {
        "ENVIRONMENT": "dev",
        "LOG_LEVEL": "DEBUG",
        "BETTER_AUTH_URL": "https://tunnel.useporte.dev",
        "GOOGLE_CLIENT_ID": "1028556002706-0qpc7c5iiov5co2hmil32egpe9mj6rba.apps.googleusercontent.com",
        "APPLE_CLIENT_ID": "test",
        "APPLE_TEAM_ID": "test",
        "APPLE_KEY_ID": "test",
        "GITHUB_CLIENT_ID": "Ov23liUlJuaiVQqCrdJd",
        "TWITTER_CLIENT_ID": "S3hlVjNQQjl0bVlyT3BDMXUxODk6MTpjaQ",
        "SENTRY_DSN": "https://public@example.com/1",
      },
      "secrets": {
        "required": [
          "BETTER_AUTH_SECRET",
          "TURNSTILE_SECRET_KEY",
          "GOOGLE_CLIENT_SECRET",
          "APPLE_PRIVATE_KEY",
          "GITHUB_CLIENT_SECRET",
          "TWITTER_CLIENT_SECRET",
          "POSTHOG_API_KEY",
        ],
      },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "porte-dev",
          "database_id": "local-porte-auth",
          "migrations_dir": "src/server/infrastructure/persistence/database/migrations",
        },
      ],
      "kv_namespaces": [{ "binding": "AUTH_KV", "id": "local-porte-auth-kv" }],
      // Better Auth keys each rate limit by address and path.
      "ratelimits": [
        {
          "name": "AUTH_RATE_LIMIT",
          "namespace_id": "2001",
          "simple": { "limit": 30, "period": 10 },
        },
      ],
      "durable_objects": {
        "bindings": [{ "name": "HOST_RELAY_AGENT", "class_name": "HostRelayAgent" }],
      },
    },
    "prod": {
      "name": "porte",
      // Custom Domain: Cloudflare owns the DNS record and cert, so no manual DNS entry.
      "routes": [{ "pattern": "useporte.dev", "custom_domain": true }],
      "triggers": { "crons": ["*/15 * * * *"] },
      "vars": {
        "ENVIRONMENT": "prod",
        "LOG_LEVEL": "INFO",
        "BETTER_AUTH_URL": "https://useporte.dev",
        "GOOGLE_CLIENT_ID": "1028556002706-vamojgd5lbd33ethun84jfnrcri4bdpq.apps.googleusercontent.com",
        // The Services ID, not the App ID. Apple signs the client secret per request.
        "APPLE_CLIENT_ID": "dev.useporte.auth",
        "APPLE_TEAM_ID": "YWALNZ357A",
        "APPLE_KEY_ID": "4WA4XS2VG3",
        "GITHUB_CLIENT_ID": "Ov23lio6JUUgjqwSK00M",
        "TWITTER_CLIENT_ID": "LXRmbnoyd25naWRYa1NnMmlkN1M6MTpjaQ",
        "SENTRY_DSN": "https://public@example.com/1",
      },
      "secrets": {
        "required": [
          "BETTER_AUTH_SECRET",
          "TURNSTILE_SECRET_KEY",
          "GOOGLE_CLIENT_SECRET",
          "APPLE_PRIVATE_KEY",
          "GITHUB_CLIENT_SECRET",
          "TWITTER_CLIENT_SECRET",
          "POSTHOG_API_KEY",
        ],
      },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "porte",
          "database_id": "ff625f0c-0361-455b-98f9-8e91b4fff253",
          "migrations_dir": "src/server/infrastructure/persistence/database/migrations",
        },
      ],
      "kv_namespaces": [{ "binding": "AUTH_KV", "id": "7da1c30d74e34d9987cc8789fdda0e2c" }],
      "ratelimits": [
        {
          "name": "AUTH_RATE_LIMIT",
          "namespace_id": "2001",
          "simple": { "limit": 30, "period": 10 },
        },
      ],
      "durable_objects": {
        "bindings": [{ "name": "HOST_RELAY_AGENT", "class_name": "HostRelayAgent" }],
      },
    },
    "test": {
      "name": "porte-test",
      "triggers": { "crons": ["*/15 * * * *"] },
      "vars": {
        "ENVIRONMENT": "test",
        "LOG_LEVEL": "ERROR",
        "BETTER_AUTH_URL": "http://localhost:3000",
        "BETTER_AUTH_SECRET": "test-better-auth-secret-with-32-characters",
        "TURNSTILE_SECRET_KEY": "1x0000000000000000000000000000000AA",
        "GOOGLE_CLIENT_ID": "test",
        "GOOGLE_CLIENT_SECRET": "test",
        "APPLE_CLIENT_ID": "test",
        "APPLE_TEAM_ID": "test",
        "APPLE_KEY_ID": "test",
        "APPLE_PRIVATE_KEY": "test",
        "GITHUB_CLIENT_ID": "test",
        "GITHUB_CLIENT_SECRET": "test",
        "TWITTER_CLIENT_ID": "test",
        "TWITTER_CLIENT_SECRET": "test",
        "SENTRY_DSN": "https://public@example.com/1",
      },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "porte-test",
          "database_id": "test-porte-auth",
          "migrations_dir": "src/server/infrastructure/persistence/database/migrations",
        },
      ],
      "kv_namespaces": [{ "binding": "AUTH_KV", "id": "test-porte-auth-kv" }],
      "ratelimits": [
        {
          "name": "AUTH_RATE_LIMIT",
          "namespace_id": "2001",
          "simple": { "limit": 30, "period": 10 },
        },
      ],
      "durable_objects": {
        "bindings": [{ "name": "HOST_RELAY_AGENT", "class_name": "HostRelayAgent" }],
      },
    },
  },
}
