{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@porte/web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "CLOUDFLARE_ENV=dev dotenvx run -f .env.dev -- vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "CLOUDFLARE_ENV=prod vite build --mode production",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src && pnpm run lint:colors",
    "lint:colors": "oxlint -c .oxlintrc.colors.json -A all src",
    "lint:fix": "oxlint src --fix && pnpm run lint:colors",
    "test": "CLOUDFLARE_ENV=test dotenvx run -f .env.test -- playwright test",
    "storybook": "dotenvx run -f .env.dev -- storybook dev -p 6006",
    "build-storybook": "dotenvx run -f .env.dev -- storybook build",
    "cf-typegen": "wrangler types",
    "preview": "CLOUDFLARE_ENV=prod vite preview",
    "deploy": "pnpm db:migrate:prod && pnpm run build && wrangler deploy --env prod",
    "better-auth-generate": "pnpm dlx @better-auth/cli@latest generate --config src/server/infrastructure/auth/auth-gen.ts --output src/server/infrastructure/persistence/database/schema/auth.schema.ts -y",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom",
    "db:generate:prod": "DRIZZLE_ENV=production drizzle-kit generate",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && pnpm run db:migrate:dev:yes",
    "db:migrate:dev": "wrangler d1 migrations apply DB --local --env dev",
    "db:migrate:dev:yes": "yes | wrangler d1 migrations apply DB --local --env dev",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote --env prod",
    "db:studio": "drizzle-kit studio",
    "db:studio:prod": "DRIZZLE_ENV=production drizzle-kit studio"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@fontsource/inter": "catalog:",
    "@fontsource/space-grotesk": "catalog:",
    "@marsidev/react-turnstile": "catalog:",
    "@phosphor-icons/react": "catalog:",
    "@porte/core": "workspace:*",
    "@posthog/react": "catalog:",
    "@radix-ui/colors": "catalog:",
    "@radix-ui/react-use-controllable-state": "catalog:",
    "@sentry/cloudflare": "catalog:",
    "@sentry/tanstackstart-react": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-devtools": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-query-devtools": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-devtools": "catalog:",
    "@tanstack/react-router-ssr-query": "catalog:",
    "@tanstack/react-start": "catalog:",
    "ai": "catalog:",
    "better-auth": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "cmdk": "catalog:",
    "drizzle-orm": "catalog:",
    "gsap": "catalog:",
    "input-otp": "catalog:",
    "motion": "catalog:",
    "nanoid": "catalog:",
    "ogl": "catalog:",
    "posthog-js": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shiki": "catalog:",
    "sonner": "catalog:",
    "streamdown": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "use-stick-to-bottom": "catalog:",
    "uuid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@dotenvx/dotenvx": "catalog:",
    "@playwright/test": "catalog:",
    "@storybook/addon-themes": "catalog:",
    "@storybook/tanstack-react": "catalog:",
    "@tailwindcss/typography": "catalog:",
    "@tanstack/devtools-vite": "catalog:",
    "@tanstack/react-store": "catalog:",
    "@tanstack/router-cli": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript-eslint/utils": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "drizzle-kit": "catalog:",
    "eslint-plugin-drizzle": "catalog:",
    "storybook": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "use-sync-external-store": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
