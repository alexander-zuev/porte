{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@lras/web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "dotenvx run -- sh -c \"NODE_OPTIONS='--import ./instrument.server.mjs' vite dev --port 3000\"",
    "generate-routes": "tsr generate",
    "build": "dotenvx run -- vite build && cp instrument.server.mjs .output/server",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "test": "playwright test",
    "storybook": "dotenvx run -- storybook dev -p 6006",
    "build-storybook": "dotenvx run -- storybook build",
    "cf-typegen": "wrangler types",
    "preview": "dotenvx run -- vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "start": "dotenvx run -- node --import ./.output/server/instrument.server.mjs .output/server/index.mjs",
    "db:generate": "dotenvx run -- drizzle-kit generate",
    "db:migrate": "dotenvx run -- drizzle-kit migrate",
    "db:push": "dotenvx run -- drizzle-kit push",
    "db:pull": "dotenvx run -- drizzle-kit pull",
    "db:studio": "dotenvx run -- drizzle-kit studio"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@fontsource/inter": "catalog:",
    "@lras/core": "workspace:*",
    "@phosphor-icons/react": "catalog:",
    "@posthog/react": "catalog:",
    "@radix-ui/react-use-controllable-state": "catalog:",
    "@sentry/tanstackstart-react": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-devtools": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-query-devtools": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-devtools": "catalog:",
    "@tanstack/react-router-ssr-query": "catalog:",
    "@tanstack/react-start": "catalog:",
    "ai": "catalog:",
    "better-auth": "catalog:",
    "better-sqlite3": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "cmdk": "catalog:",
    "drizzle-orm": "catalog:",
    "input-otp": "catalog:",
    "motion": "catalog:",
    "nanoid": "catalog:",
    "posthog-js": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shiki": "catalog:",
    "streamdown": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "use-stick-to-bottom": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@cloudflare/vite-plugin": "catalog:",
    "@dotenvx/dotenvx": "catalog:",
    "@playwright/test": "catalog:",
    "@storybook/addon-themes": "catalog:",
    "@storybook/tanstack-react": "catalog:",
    "@tailwindcss/typography": "catalog:",
    "@tanstack/devtools-vite": "catalog:",
    "@tanstack/router-cli": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "drizzle-kit": "catalog:",
    "storybook": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "wrangler": "catalog:"
  }
}
