{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "paths": {
      "@web/*": ["./src/*"],
      "@server/*": ["./src/server/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    // Stories stay in the main pass so `@web/*` resolves and a rename that
    // misses them fails the build instead of the browser.
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "drizzle.config.ts",
    "worker-configuration.d.ts"
  ]
}
