# =============================================================================
# CLIENT — VITE_ prefix, baked into the JS bundle by Vite
# =============================================================================
# dotenvx injects these into process.env; Vite exposes them as import.meta.env.
# Local: pnpm exec dotenvx set KEY value -f .env.dev
# Test:  pnpm exec dotenvx set KEY value -f .env.test
# Production builds: set the same keys in CI / Workers Builds.

VITE_SENTRY_DSN=https://public@example.com/1
VITE_POSTHOG_KEY=
# Same PostHog project token, read by the Worker rather than the browser.
POSTHOG_API_KEY=
# Local widget (localhost). Test/Storybook: Cloudflare always-pass 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAEVVSsKSyQ4roGZ2

# =============================================================================
# SERVER — Worker secrets (wrangler.jsonc secrets.required)
# =============================================================================
# Do not add `.dev.vars` — Wrangler will ignore this file.
# Production: wrangler secret put KEY --env prod
# Commit .env.dev and .env.test. Never commit .env.keys.

PORTE_DEV_DAEMON_TOKEN=replace-me
PORTE_DEV_CLIENT_TOKEN=replace-me
BETTER_AUTH_SECRET=replace-with-32-plus-random-chars
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
GOOGLE_CLIENT_SECRET=test
# The .p8 contents from the Apple Sign In key. Signed into a JWT at request time.
APPLE_PRIVATE_KEY=test
GITHUB_CLIENT_SECRET=test
TWITTER_CLIENT_SECRET=test
SENTRY_AUTH_TOKEN=
