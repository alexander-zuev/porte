{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@porte/cli",
  "version": "0.1.2",
  "description": "Run your local Grok sessions from your phone. The daemon that pairs a machine with useporte.dev.",
  "keywords": [
    "acp",
    "agent",
    "cli",
    "grok",
    "remote"
  ],
  "homepage": "https://useporte.dev",
  "bugs": "https://github.com/alexander-zuev/porte/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexander-zuev/porte.git",
    "directory": "apps/host"
  },
  "bin": {
    "porte": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsdown",
    "prepack": "cp ../../README.md README.md",
    "postpack": "rm -f README.md",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "test": "vitest run --exclude tests/e2e/**",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "catalog:",
    "@better-fetch/fetch": "catalog:",
    "partysocket": "catalog:",
    "picocolors": "catalog:",
    "ws": "catalog:"
  },
  "devDependencies": {
    "@porte/core": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "better-result": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
