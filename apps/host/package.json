{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@porte/cli",
  "version": "0.3.3",
  "description": "Run your local Grok sessions from your phone. The daemon that pairs a machine with useporte.dev.",
  "keywords": [
    "acp",
    "agent",
    "cli",
    "grok",
    "remote"
  ],
  "homepage": "https://useporte.dev",
  "bugs": "https://github.com/alexander-zuev/porte/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexander-zuev/porte.git",
    "directory": "apps/host"
  },
  "bin": {
    "porte": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "dev:pair": "PORTE_URL=https://tunnel.useporte.dev PORTE_DATA_DIRECTORY=$HOME/.porte-dev tsx src/main.ts pair",
    "dev:up": "PORTE_URL=https://tunnel.useporte.dev PORTE_DATA_DIRECTORY=$HOME/.porte-dev tsx src/main.ts up",
    "dev:unpair": "PORTE_URL=https://tunnel.useporte.dev PORTE_DATA_DIRECTORY=$HOME/.porte-dev tsx src/main.ts unpair",
    "build": "tsdown",
    "prepack": "cp ../../README.md README.md",
    "postpack": "rm -f README.md",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:live": "GROK_LIVE_TESTS=1 vitest run --project live"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "catalog:",
    "@better-fetch/fetch": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "partysocket": "catalog:",
    "picocolors": "catalog:",
    "ws": "catalog:"
  },
  "devDependencies": {
    "@porte/core": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "better-result": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
